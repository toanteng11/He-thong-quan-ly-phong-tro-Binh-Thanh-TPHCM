NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://127.0.0.1:5173
ADMIN_ORIGIN=http://127.0.0.1:5174
TRUST_PROXY=0
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

# Local MongoDB 8 (Docker Compose) or MongoDB Atlas M0 Free URI (mongodb+srv://...)
MONGO_INITDB_ROOT_USERNAME=room_rental_app
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-local-only-password
MONGODB_URI=mongodb://room_rental_app:replace-with-a-local-only-password@127.0.0.1:27018/room_rental_dev?authSource=admin
MONGODB_DB_NAME=room_rental_dev

# Image Storage: "local" (dev) or "cloudinary" (production Free Tier)
IMAGE_STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=room-rental-binh-thanh

# Backup & Alerting (Sprint 4)
BACKUP_ROOT=backups
ALERT_WEBHOOK_URL=
